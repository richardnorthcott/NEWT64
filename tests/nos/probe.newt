// Calls each function NewtNOS.c adds and prints "label => value", one line
// per case. Values show their type: r before a real, $ before a character,
// <n> for a character code above 126.
//
//   newt64 tests/nos/probe.newt > out.txt && python3 tests/nos/compare.py out.txt
local emit := func(s) Print(s & "\n");
local show := func(v) begin
  if IsString(v) then begin local t := "\""; for i := 0 to StrLen(v) - 1 do begin local c := Ord(v[i]); t := t & (if c > 126 then "<" & c & ">" else v[i]) end; return t & "\"" end;
  if IsSymbol(v) then return "'" & v;
  if IsCharacter(v) then return (if Ord(v) > 126 then "$<" & Ord(v) & ">" else "$" & v);
  if v = nil then return "nil";
  if v = true then return "true";
  if IsReal(v) then return "r" & v;
  if IsInteger(v) then return "" & v;
  if IsArray(v) then begin local s := "["; foreach i, x in v do s := s & (if i > 0 then ", " else "") & call show with (x); return s & "]" end;
  if IsFrame(v) then begin local s := "{"; local first := true; foreach k, x in v do begin s := s & (if first then "" else ", ") & k & ": " & call show with (x); first := nil end; return s & "}" end;
  if IsBinary(v) then begin local s := "<" & ClassOf(v) & " " & Length(v) & ":"; for i := 0 to Length(v) - 1 do s := s & " " & ExtractByte(v, i); return s & ">" end;
  if IsFunction(v) then return "<function>";
  "<?>";
end;
local zb := func(n) begin local b := MakeBinary(n, 'data); for i := 0 to n - 1 do StuffByte(b, i, 0); b end;
local cases := [
 "Floor(3.7)", func() Floor(3.7),
 "Floor(-3.2)", func() Floor(-3.2),
 "Floor(5)", func() Floor(5),
 "Ceiling(3.2)", func() Ceiling(3.2),
 "Ceiling(-3.7)", func() Ceiling(-3.7),
 "Round(2.5)", func() Round(2.5),
 "Round(-2.5)", func() Round(-2.5),
 "Round(3.49)", func() Round(3.49),
 "Round(4)", func() Round(4),
 "Trunc(3.7)", func() Trunc(3.7),
 "Trunc(-3.7)", func() Trunc(-3.7),
 "Abs(-4)", func() Abs(-4),
 "Abs(-4.5)", func() Abs(-4.5),
 "Max(3, 9)", func() Max(3, 9),
 "Max(3.5, 2)", func() Max(3.5, 2),
 "Min(3, 9)", func() Min(3, 9),
 "Min(2, 2.5)", func() Min(2, 2.5),
 "Sqrt(16)", func() Sqrt(16),
 "Sqrt(2)", func() Sqrt(2),
 "Real(3)", func() Real(3),
 "Signum(-5)", func() Signum(-5),
 "Signum(0)", func() Signum(0),
 "Signum(2.5)", func() Signum(2.5),
 "Sin(0)", func() Sin(0),
 "Cos(0)", func() Cos(0),
 "Atan2(1, 1)", func() Atan2(1, 1),
 "Exp(1)", func() Exp(1),
 "Log(10)", func() Log(10),
 "Log10(1000)", func() Log10(1000),
 "Pow(2, 10)", func() Pow(2, 10),
 "Pow(2.0, 0.5)", func() Pow(2.0, 0.5),
 "Fmod(7, 3)", func() Fmod(7, 3),
 "Hypot(3, 4)", func() Hypot(3, 4),
 "Rint(2.5)", func() Rint(2.5),
 "NearbyInt(3.5)", func() NearbyInt(3.5),
 "CopySign(3, -1)", func() CopySign(3, -1),
 "Fabs(-2)", func() Fabs(-2),
 "FMax(1, 2)", func() FMax(1, 2),
 "Remainder(7, 2)", func() Remainder(7, 2),
 "IsNaN(1.5)", func() IsNaN(1.5),
 "IsFinite(1.5)", func() IsFinite(1.5),
 "Random(5, 5)", func() Random(5, 5),
 "BXor(12, 10)", func() BXor(12, 10),
 "BAnd(12, 10)", func() BAnd(12, 10),
 "BOr(12, 10)", func() BOr(12, 10),
 "-7 div 2", func() -7 div 2,
 "-7 mod 3", func() -7 mod 3,
 "7 / 2", func() 7 / 2,
 "Upcase", func() begin local s := Clone("abc dEf"); local r := Upcase(s); [r, s] end,
 "Upcase latin1", func() Upcase(Clone("caf\u00E9\u")),
 "Downcase", func() begin local s := Clone("ABC dEf"); local r := Downcase(s); [r, s] end,
 "Capitalize", func() begin local s := Clone("hello world"); local r := Capitalize(s); [r, s] end,
 "CapitalizeWords", func() begin local s := Clone("hello big  world"); local r := CapitalizeWords(s); [r, s] end,
 "TrimString", func() begin local s := Clone("  hi there \t "); local r := TrimString(s); [r, s] end,
 "StrMunger replace", func() begin local s := Clone("hello"); local r := StrMunger(s, 1, 2, "EY", 0, nil); [r, s] end,
 "StrMunger insert", func() begin local s := Clone("hello"); local r := StrMunger(s, 2, 0, "XYZ", 1, 1); [r, s] end,
 "StrMunger delete", func() begin local s := Clone("hello"); local r := StrMunger(s, 1, 3, nil, 0, nil); [r, s] end,
 "StrMunger nil count", func() begin local s := Clone("hello"); local r := StrMunger(s, 2, nil, "P", 0, nil); [r, s] end,
 "StrCompare(abc, abd)", func() StrCompare("abc", "abd"),
 "StrCompare(b, a)", func() StrCompare("b", "a"),
 "StrCompare(abc, ABC)", func() StrCompare("abc", "ABC"),
 "StrEqual(abc, ABC)", func() StrEqual("abc", "ABC"),
 "StrExactCompare(abc, ABC)", func() StrExactCompare("abc", "ABC"),
 "StringToNumber(42)", func() StringToNumber("42"),
 "StringToNumber(3.5)", func() StringToNumber("3.5"),
 "StringToNumber(abc)", func() StringToNumber("abc"),
 "StringToNumber( 12 )", func() StringToNumber(" 12 "),
 "StringToNumber(-7)", func() StringToNumber("-7"),
 "StringToNumber(12abc)", func() StringToNumber("12abc"),
 "NumberStr(42)", func() NumberStr(42),
 "NumberStr(3.5)", func() NumberStr(3.5),
 "NumberStr(-1)", func() NumberStr(-1),
 "StrConcat", func() StrConcat("ab", "cd"),
 "CharPos(l,0)", func() CharPos("hello", $l, 0),
 "CharPos(l,3)", func() CharPos("hello", $l, 3),
 "CharPos(z,0)", func() CharPos("hello", $z, 0),
 "StrReverse", func() StrReverse("abc"),
 "StrTokenize", func() begin local t := StrTokenize("1.2..3", $.); local out := []; local x; while x := call t with () do AddArraySlot(out, x); out end,
 "StrPos(l)", func() StrPos("hello", "l", 0),
 "StrPos(L)", func() StrPos("hello", "L", 0),
 "StrPosExact(L)", func() StrPosExact("hello", "L", 0),
 "SubStr", func() SubStr("hello", 1, 3),
 "BeginsWith(He)", func() BeginsWith("hello", "He"),
 "EndsWith(LO)", func() EndsWith("hello", "LO"),
 "IsAlphaNumeric(a)", func() IsAlphaNumeric($a),
 "IsAlphaNumeric(-)", func() IsAlphaNumeric($-),
 "IsWhiteSpace(sp)", func() IsWhiteSpace($ ),
 "IsWhiteSpace(a)", func() IsWhiteSpace($a),
 "IsAlpha(a)", func() IsAlpha($a),
 "IsAlpha(1)", func() IsAlpha($1),
 "IsDigit(5)", func() IsDigit($5),
 "IsUpper(A)", func() IsUpper($A),
 "IsLower(A)", func() IsLower($A),
 "SubstituteChars", func() begin local s := Clone("a-b-c"); local r := SubstituteChars(s, "-", "+"); [r, s] end,
 "StripDiacriticals", func() begin local s := Clone("caf\u00E9\u"); local r := StripDiacriticals(s); [r, s] end,
 "SymbolName", func() SymbolName('Hello),
 "MakeSymbol", func() MakeSymbol("Hello"),
 "Intern", func() Intern("Hello"),
 "Stringer", func() Stringer([1, "a", $b, 'c, 2.5]),
 "StrLen", func() StrLen("hello"),
 "ArrayInsert mid", func() begin local a := [1, 2, 3]; local r := ArrayInsert(a, 9, 1); [r, a] end,
 "ArrayInsert end", func() begin local a := [1, 2]; local r := ArrayInsert(a, 9, 2); [r, a] end,
 "ArrayRemoveCount", func() begin local a := [1, 2, 3, 4]; local r := ArrayRemoveCount(a, 1, 2); [r, a] end,
 "ArrayMunger", func() begin local a := [1, 2, 3, 4]; local r := ArrayMunger(a, 1, 2, [8, 9, 7], 0, nil); [r, a] end,
 "ArrayMunger nil src", func() begin local a := [1, 2, 3, 4]; local r := ArrayMunger(a, 1, 2, nil, 0, nil); [r, a] end,
 "ArrayPos(2)", func() ArrayPos([1, 2, 3], 2, 0, nil),
 "ArrayPos(2, from 2)", func() ArrayPos([1, 2, 3, 2], 2, 2, nil),
 "ArrayPos(miss)", func() ArrayPos([1], 5, 0, nil),
 "ArrayPos(fn)", func() ArrayPos(["a", "b"], "B", 0, func(a, b) StrEqual(a, b)),
 "ArrayPos(str)", func() ArrayPos(["a", "b"], "b", 0, nil),
 "LSearch(=)", func() LSearch([1, 2, 3], 2, 0, '|=|, nil),
 "LSearch(key)", func() LSearch([{a: 1}, {a: 2}], 2, 0, '|=|, 'a),
 "LSearch(str=)", func() LSearch(["a", "B"], "b", 0, '|str=|, nil),
 "LSearch(miss)", func() LSearch([1, 2, 3], 7, 0, '|=|, nil),
 "Sort(<)", func() begin local a := [3, 1, 2]; local r := Sort(a, '|<|, nil); [r, a] end,
 "Sort(>)", func() Sort([3, 1, 2], '|>|, nil),
 "Sort(str<)", func() Sort(["b", "A", "c"], '|str<|, nil),
 "Sort(str>)", func() Sort(["b", "A", "c"], '|str>|, nil),
 "Sort(key)", func() begin local r := Sort([{k: 2, n: "b"}, {k: 1, n: "a"}], '|<|, 'k); [r[0].n, r[1].n] end,
 "Sort(fn)", func() Sort([3, 1, 2], func(a, b) b - a, nil),
 "Sort(keyfn)", func() Sort([3, -1, 2], '|<|, func(x) x * x),
 "StableSort(key)", func() begin local r := StableSort([{k: 1, n: "a"}, {k: 0, n: "b"}, {k: 1, n: "c"}, {k: 0, n: "d"}], '|<|, 'k); foreach x in r collect x.n end,
 "InsertionSort", func() InsertionSort([3, 1, 2], '|<|, nil),
 "SetAdd uniq", func() begin local a := [1, 2]; local r := SetAdd(a, 2, true); [r, a] end,
 "SetAdd new", func() begin local a := [1, 2]; local r := SetAdd(a, 3, true); [r, a] end,
 "SetAdd dup", func() begin local a := [1, 2]; local r := SetAdd(a, 2, nil); [r, a] end,
 "SetRemove", func() begin local a := [1, 2, 3, 2]; local r := SetRemove(a, 2); [r, a] end,
 "SetUnion uniq", func() begin local a := [1, 2, 2]; local r := SetUnion(a, [2, 3], true); [r, a] end,
 "SetUnion", func() SetUnion([1, 2], [2, 3], nil),
 "SetDifference", func() begin local a := [1, 2, 3, 2]; local r := SetDifference(a, [2]); [r, a] end,
 "SetOverlaps yes", func() SetOverlaps([1, 2], [3, 2]),
 "SetOverlaps no", func() SetOverlaps([1], [2]),
 "SetContains", func() SetContains([1, 2], 2),
 "Map array", func() begin local a := [1, 2, 3]; local seen := []; local r := Map(a, func(k, v) begin AddArraySlot(seen, k); v * 2 end); [r, a, seen] end,
 "Map frame", func() begin local f := {x: 1}; local seen := []; local r := Map(f, func(k, v) begin AddArraySlot(seen, k); v + 1 end); [r, f, seen] end,
 "Stuff/Extract byte word", func() begin local b := call zb with (8); StuffByte(b, 0, 255); StuffWord(b, 2, 0x1234); [b, ExtractByte(b, 0), ExtractWord(b, 2)] end,
 "StuffLong", func() begin local b := call zb with (8); local r := StuffLong(b, 0, 0x01234567); StuffLong(b, 4, -2); [r, b, ExtractLong(b, 0), ExtractLong(b, 4), ExtractXLong(b, 4)] end,
 "StuffChar", func() begin local b := call zb with (4); local r := StuffChar(b, 0, $A); StuffUniChar(b, 2, $B); [r, b, ExtractChar(b, 0), ExtractUniChar(b, 2)] end,
 "StuffCString", func() begin local b := call zb with (6); local r := StuffCString(b, 0, "Hi"); [r, b, ExtractCString(b, 0)] end,
 "StuffPString", func() begin local b := call zb with (6); local r := StuffPString(b, 0, "Hi"); [r, b, ExtractPString(b, 0)] end,
 "ExtractBytes", func() begin local b := call zb with (4); StuffByte(b, 1, 7); StuffByte(b, 2, 8); ExtractBytes(b, 1, 2, 'foo) end,
 "BinEqual", func() begin local a := call zb with (2); local b := call zb with (2); local c := call zb with (3); [BinEqual(a, b), BinEqual(a, c)] end,
 "BinaryMunger", func() begin local a := call zb with (3); local b := call zb with (2); StuffByte(b, 0, 5); StuffByte(b, 1, 6); local r := BinaryMunger(a, 1, 1, b, 0, 2); [r, a] end,
 "Date", func() Date(64589272),
 "Date(0)", func() Date(0),
 "TotalMinutes", func() TotalMinutes(Date(64589272)),
 "GetFunctionArgCount", func() GetFunctionArgCount(func(a, b) nil),
 "fmt 0.0", func() "" & 0.0,
 "fmt -2.5", func() "" & -2.5,
 "fmt 0.1", func() "" & 0.1,
 "fmt 100.0", func() "" & 100.0,
 "fmt 123456.7", func() "" & 123456.7,
 "fmt 1234567.0", func() "" & 1234567.0,
 "fmt 1e10", func() "" & 10000000000.0,
 "fmt 1.5e-7", func() "" & 0.00000015,
 "fmt 1/3", func() "" & (1 / 3),
 "fmt 2/3", func() "" & (2 / 3),
 "NumberStr(0.1)", func() NumberStr(0.1),
 "NumberStr(1/3)", func() NumberStr(1 / 3),
 "NumberStr(1234567.0)", func() NumberStr(1234567.0),
 "NumberStr(1e10)", func() NumberStr(10000000000.0),
 "NumberStr(0.0)", func() NumberStr(0.0),
 "Stringer(0.0)", func() Stringer([0.0, 3.0]),
 "SetOverlaps pos", func() SetOverlaps([1, 2, 3], [3, 9]),
 "SetOverlaps pos2", func() SetOverlaps([9, 8, 7, 1], [5, 1, 7]),
 "ExtractXLong", func() begin local b := MakeBinary(8, 'data); StuffLong(b, 0, 0x01234567); StuffLong(b, 4, 0x00000100); [ExtractXLong(b, 0), ExtractXLong(b, 4), ExtractLong(b, 0)] end,
 "ExtractLong big", func() begin local b := MakeBinary(4, 'data); StuffByte(b, 0, 0x7F); StuffByte(b, 1, 255); StuffByte(b, 2, 255); StuffByte(b, 3, 255); ExtractLong(b, 0) end,
 "Upcase e-acute", func() Upcase(Clone("caf\u00E9\u")),
 "Downcase E-acute", func() Downcase(Clone("CAF\u00C9\u")),
 "Upcase len", func() StrLen(Upcase(Clone("caf\u00E9\u"))),
 "IsAlpha e-acute", func() IsAlpha($\u00E9),
 "IsUpper E-acute", func() IsUpper($\u00C9),
 "StripDiacriticals e", func() StripDiacriticals(Clone("caf\u00E9\u \u00FC00D1\u")),
 "StrCompare(ab, abc)", func() StrCompare("ab", "abc"),
 "StrCompare(b, abc)", func() StrCompare("b", "abc"),
 "StrCompare(a-acute, b)", func() StrCompare("\u00E1\u", "b"),
 "TrimString blank", func() TrimString(Clone("   ")),
 "TrimString nl", func() TrimString(Clone("\nx\n")),
 "StrTokenize ws", func() begin local t := StrTokenize("a b", nil); local out := []; local x; while x := call t with () do AddArraySlot(out, x); out end,
 "StrTokenize str", func() begin local t := StrTokenize("a,b;c", ",;"); local out := []; local x; while x := call t with () do AddArraySlot(out, x); out end,
 "Date leap", func() Date(TotalMinutes({year: 2024, month: 2, date: 29, hour: 13, minute: 5})),
 "TotalMinutes partial", func() TotalMinutes({year: 2026, month: 1, date: 1}),
 "TotalMinutes frame2", func() TotalMinutes({year: 1904, month: 1, date: 1, hour: 0, minute: 0}),
 "Date 2100", func() Date(TotalMinutes({year: 2100, month: 3, date: 1, hour: 0, minute: 0})),
 "Random range", func() begin local ok := true; for i := 1 to 50 do begin local r := Random(3, 5); if r < 3 or r > 5 or not IsInteger(r) then ok := nil end; ok end,
 "Abs(-0)", func() Abs(0),
 "Max(str)", func() Max("a", "b"),
 "Floor(1e10)", func() Floor(10000000000.0),
 "Floor(string)", func() Floor("x"),
 "Upcase(sym)", func() Upcase('abc),
 "Capitalize empty", func() Capitalize(Clone("")),
 "CapitalizeWords punct", func() CapitalizeWords(Clone("o'neil-smith x.y")),
 "ArrayInsert past", func() ArrayInsert([1], 2, 5),
 "ArrayRemoveCount over", func() begin local a := [1, 2, 3]; ArrayRemoveCount(a, 2, 5); a end,
 "LSearch(<)", func() LSearch([1, 5, 9], 4, 0, '|<|, nil),
 "LSearch(>)", func() LSearch([1, 5, 9], 4, 0, '|>|, nil),
 "LSearch(fn)", func() LSearch([1, 5, 9], 5, 0, func(a, b) a - b, nil),
 "LSearch(path)", func() LSearch([{a: {b: 1}}, {a: {b: 2}}], 2, 0, '|=|, '[pathExpr: a, b]),
 "Sort(str<) case", func() Sort(["b", "B", "a", "A"], '|str<|, nil),
 "Sort(<) str", func() Sort(["b", "a", "C"], '|<|, nil),
 "Sort(<) mixed", func() Sort([2.5, 1, 3], '|<|, nil),
 "Sort(path)", func() begin local r := Sort([{a: {b: 2}, n: 2}, {a: {b: 1}, n: 1}], '|<|, '[pathExpr: a, b]); [r[0].n, r[1].n] end,
 "Sort(<) sym", func() Sort(['b, 'a], '|<|, nil),
 "Map return", func() Map([1], func(k, v) nil),
 "SetUnion frames", func() Length(SetUnion([{}, {}], [], true)),
 "ExtractBytes class nil", func() ClassOf(ExtractBytes(MakeBinary(4, 'data), 0, 2, nil)),
 "ExtractCString latin", func() begin local b := MakeBinary(3, 'data); StuffByte(b, 0, 0x8E); StuffByte(b, 1, 0x41); StuffByte(b, 2, 0); Ord(ExtractCString(b, 0)[0]) end,
 "ExtractChar hi", func() begin local b := MakeBinary(1, 'data); StuffByte(b, 0, 0x8E); Ord(ExtractChar(b, 0)) end,
 "StuffChar hi", func() begin local b := MakeBinary(1, 'data); StuffChar(b, 0, $\u00E9); ExtractByte(b, 0) end,
 "StrPos(start)", func() StrPos("hello", "l", 3),
 "SymbolName(case)", func() SymbolName('hello),
 "Ord", func() Ord($a),
 "Chr", func() Chr(66),
 "IsWhiteSpace(tab)", func() IsWhiteSpace($\t),
 "IsAlphaNumeric(9)", func() IsAlphaNumeric($9),
 "StringToNumber(1e3)", func() StringToNumber("1e3"),
 "StringToNumber(,)", func() StringToNumber("1,000"),
 "StringToNumber(.5)", func() StringToNumber(".5"),
 "StringToNumber(empty)", func() StringToNumber(""),
 "StringToNumber(+3)", func() StringToNumber("+3"),
 "StrConcat nil", func() StrConcat("a", nil),
 "StrReverse empty", func() StrReverse(""),
 "BinEqual str", func() BinEqual("ab", "ab"),
 "SubstituteChars multi", func() SubstituteChars("abcabc", "ab", "xy"),
 "Upcase ord", func() Ord(Upcase("" & Chr(233))[0]),
 "Downcase ord", func() Ord(Downcase("" & Chr(201))[0]),
 "StripDiacriticals ord", func() begin local s := StripDiacriticals("" & Chr(233) & Chr(252) & Chr(209)); [Ord(s[0]), Ord(s[1]), Ord(s[2])] end,
];
for i := 0 to Length(cases) - 1 by 2 do begin
  local v;
  try v := call show with (call cases[i + 1] with ())
  onexception |evt.ex| do begin local e := CurrentException(); v := "EXC " & e.name & " " & (if HasSlot(e, 'error) then e.error else ""); end;
  call emit with (cases[i] & " => " & v);
end;
call emit with ("PROBE-DONE");
